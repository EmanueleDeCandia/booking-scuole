# Configurazione Database PostgreSQL per la Produzione
# (Opzionale in locale: se omesso, l'applicazione usa automaticamente un database locale embedded .data/pglite)
DATABASE_URL=postgresql://postgres:[PASSWORD]@localhost:5432/booking_db

# Firebase Web Client Configuration (Progetto: booking-scuole)
# Dalla Firebase Console > Impostazioni Progetto > Generali > Le tue app > Web app (</>)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=booking-scuole.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=booking-scuole
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=booking-scuole.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
NEXT_PUBLIC_FIREBASE_APP_ID=1:...:web:...

# Firebase Admin SDK Configuration (Server-Side)
# Dalla Firebase Console > Impostazioni Progetto > Account di Servizio > Genera nuova chiave privata
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@booking-scuole.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Segreto per proteggere l'endpoint di cron promemoria (/api/reminders/run)
CRON_SECRET=super_secret_random_token_here

# Password o PIN di Direzione per accedere come Gestore
MANAGER_PASSWORD=scuola2026

# Opzionale: URL pubblico dell'applicazione
NEXT_PUBLIC_APP_URL=http://localhost:3000

